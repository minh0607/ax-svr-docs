    { "type": "gauge", "title": "Memory utilization", "id": 21, "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 }, "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" },
