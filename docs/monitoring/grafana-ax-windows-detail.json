{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "title": "AX · Windows Servers (Detail)",
  "tags": ["ax-svr", "zabbix", "windows", "os"],
  "schemaVersion": 39,
  "templating": { "list": [
    { "name": "ds", "label": "Zabbix datasource", "type": "datasource", "query": "alexanderzobnin-zabbix-datasource", "current": {}, "hide": 0 }
  ] },
  "__hostFilter": "/AX-WEB/",
