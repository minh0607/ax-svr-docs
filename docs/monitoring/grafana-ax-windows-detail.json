    { "type": "timeseries", "title": "Free / Available memory", "id": 22, "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 }, "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
