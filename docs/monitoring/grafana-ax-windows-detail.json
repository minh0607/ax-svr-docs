      "targets": [ { "refId": "A", "queryType": "0", "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" }, "group": { "filter": "/.*/" }, "host": { "filter": "/AX-WEB/" }, "application": { "filter": "" }, "itemTag": { "filter": "" }, "item": { "filter": "/Free memory|Available memory/" }, "functions": [] } ] },
    { "type": "timeseries", "title": "Swap / paging space", "id": 23, "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 }, "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "queryType": "0", "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" }, "group": { "filter": "/.*/" }, "host": { "filter": "/AX-WEB/" }, "application": { "filter": "" }, "itemTag": { "filter": "" }, "item": { "filter": "/Free (swap|paging)/" }, "functions": [] } ] },

    { "type": "row", "title": "Disk / Storage", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }, "id": 30 },
    { "type": "bargauge", "title": "Filesystem space used % (all drives)", "id": 31, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 }, "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "gradient", "orientation": "horizontal" },
      "targets": [ { "refId": "A", "queryType": "0", "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" }, "group": { "filter": "/.*/" }, "host": { "filter": "/AX-WEB/" }, "application": { "filter": "" }, "itemTag": { "filter": "" }, "item": { "filter": "/: Space utilization/" }, "functions": [] } ] },
    { "type": "timeseries", "title": "Filesystem space trend", "id": 32, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 }, "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "queryType": "0", "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" }, "group": { "filter": "/.*/" }, "host": { "filter": "/AX-WEB/" }, "application": { "filter": "" }, "itemTag": { "filter": "" }, "item": { "filter": "/: Space utilization/" }, "functions": [] } ] },

    { "type": "row", "title": "Network", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 }, "id": 40 },
    { "type": "timeseries", "title": "Interface throughput (bits in/out)", "id": 41, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 }, "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "bps", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "queryType": "0", "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" }, "group": { "filter": "/.*/" }, "host": { "filter": "/AX-WEB/" }, "application": { "filter": "" }, "itemTag": { "filter": "" }, "item": { "filter": "/Bits (received|sent)/" }, "functions": [] } ] },
    { "type": "timeseries", "title": "Packets dropped/discarded/errors", "id": 42, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 }, "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "pps", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "queryType": "0", "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" }, "group": { "filter": "/.*/" }, "host": { "filter": "/AX-WEB/" }, "application": { "filter": "" }, "itemTag": { "filter": "" }, "item": { "filter": "/packets (dropped|discarded|with errors)/" }, "functions": [] } ] },

    { "type": "row", "title": "IIS", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 }, "id": 50 },
    { "type": "text", "title": "IIS metrics — not yet available", "id": 51, "gridPos": { "h": 4, "w": 24, "x": 0, "y": 43 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "mode": "markdown", "content": "**IIS metrics cần thêm perf_counter items — xem PREREQUISITES.**\n\nBase \"Windows by Zabbix agent\" template không có item IIS. Cần thêm `perf_counter[]` items (Current Connections, Requests/sec, Requests Queued, Bytes Sent/Received) hoặc gắn template IIS riêng trước khi panel này có dữ liệu." }
    }
  ]
