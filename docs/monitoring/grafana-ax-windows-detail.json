    { "type": "stat", "title": "Agent availability", "id": 2, "gridPos": { "h": 5, "w": 12, "x": 0, "y": 1 }, "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 0 }, "2": { "text": "DOWN", "color": "red", "index": 1 }, "0": { "text": "UNK", "color": "orange", "index": 2 } } } ], "color": { "mode": "fixed" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "orientation": "horizontal" },
      "targets": [ { "refId": "A", "queryType": "0", "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" }, "group": { "filter": "/.*/" }, "host": { "filter": "/AX-WEB/" }, "application": { "filter": "" }, "itemTag": { "filter": "" }, "item": { "filter": "/Zabbix agent availability/" }, "functions": [] } ] },
    { "type": "stat", "title": "Uptime", "id": 3, "gridPos": { "h": 5, "w": 12, "x": 12, "y": 1 }, "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 3600 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "orientation": "horizontal" },
      "targets": [ { "refId": "A", "queryType": "0", "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" }, "group": { "filter": "/.*/" }, "host": { "filter": "/AX-WEB/" }, "application": { "filter": "" }, "itemTag": { "filter": "" }, "item": { "filter": "/System uptime/" }, "functions": [] } ] },

    { "type": "row", "title": "CPU", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "id": 10 },
    { "type": "timeseries", "title": "CPU utilization", "id": 11, "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 }, "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "queryType": "0", "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${ds}" }, "group": { "filter": "/.*/" }, "host": { "filter": "/AX-WEB/" }, "application": { "filter": "" }, "itemTag": { "filter": "" }, "item": { "filter": "/CPU utilization/" }, "functions": [] } ] },

