      {
        "name": "ds",
        "label": "Zabbix datasource",
        "type": "datasource",
        "query": "alexanderzobnin-zabbix-datasource",
        "current": {
          "selected": true,
          "text": "Zabbix",
          "value": "Zabbix"
        },
        "hide": 0
      },
      {
        "name": "group",
        "label": "Host group",
        "type": "query",
        "hide": 0,
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "${ds}"
        },
        "definition": "Zabbix host groups",
        "query": {
          "queryType": "group",
          "group": {
            "filter": "/.*/"
          },
          "host": {
            "filter": ""
          },
          "application": {
            "filter": ""
          },
          "item": {
            "filter": ""
          }
        },
        "refresh": 1,
        "sort": 1,
        "regex": "",
        "includeAll": true,
        "allValue": "/.*/",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "hide": 0,
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "${ds}"
        },
        "definition": "Zabbix hosts (filtered by $group)",
        "query": {
          "queryType": "host",
          "group": {
            "filter": "$group"
          },
          "host": {
            "filter": "/.*/"
          },
          "application": {
            "filter": ""
          },
          "item": {
            "filter": ""
          }
        },
        "refresh": 1,
        "sort": 1,
        "regex": "",
        "includeAll": true,
        "allValue": "/AX-/",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
